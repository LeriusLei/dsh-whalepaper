{
  "name": "dsh-whalepaper",
  "version": "0.6.1",
  "type": "module",
  "description": "Live ASCII orca wallpaper for DeepSeek Harness, with a transparent chat workspace and settings in the plugin configuration page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeriusLei/dsh-whalepaper.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "default-settings.json",
    "cordis.patch.yml",
    "wallpaper/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/REFERENCES.md",
    "docs/HARNESS.md",
    "docs/DSH-HANDOFF.md",
    "docs/CONTROLS-FIX-0.6.1.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node --test tests/controls.test.cjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.15"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wallpaper",
    "ascii",
    "orca"
